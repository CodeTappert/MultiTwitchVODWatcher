{
  "name": "vod-sync-local",
  "version": "1.0.0",
  "description": "Local multi-VOD sync player with yt-dlp downloads and session persistence",
  "author": "Jannik Tappert <38758606+CodeTappert@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "e2e": "playwright test",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dertapp.twitchvodsync",
    "productName": "Twitch VOD Sync",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CodeTappert",
        "repo": "MultiTwitchVODWatcher"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "lib/**",
      "index.html",
      "styles.css",
      "locales/**",
      "bin/**",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
